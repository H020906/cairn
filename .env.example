# Cairn coordinator configuration.
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# --- Datastores -------------------------------------------------------------
# Match docker-compose.yml for local development.
CAIRN_DB_URL=jdbc:postgresql://localhost:5432/cairn
CAIRN_DB_USER=cairn
CAIRN_DB_PASSWORD=cairn_local_dev

CAIRN_REDIS_URL=redis://localhost:6379

# --- Server -----------------------------------------------------------------
CAIRN_HTTP_PORT=8080
# Origins permitted to open a worker WebSocket. Comma-separated, no wildcards in
# production — a hostile origin can enlist visitors' browsers as workers.
CAIRN_ALLOWED_ORIGINS=http://localhost:5173

# --- Verification policy ----------------------------------------------------
# See docs/adr/0001-verification-by-dispute-not-replication.md. These three values are
# the cost/confidence dial for the whole network; the benchmark suite exists to
# calibrate them rather than to justify the defaults below.

# Fraction of assigned units that are canaries with a known answer. Higher catches
# cheating faster and costs proportionally more.
CAIRN_CANARY_RATE=0.03

# Fraction of ordinary units given a second independent execution. Applies on top of the
# unconditional replication that new and low-reputation workers always receive.
CAIRN_REPLICATION_RATE=0.10

# Reputation below which a worker's every unit is replicated regardless of the rate above.
CAIRN_REPUTATION_FLOOR=0.90

# Instructions between execution-trace snapshots, as a power of two. Lower means finer
# arbitration and more snapshot overhead; higher means cheaper execution and more work
# to replay a disputed step.
CAIRN_SNAPSHOT_INTERVAL_LOG2=16

# --- Leases -----------------------------------------------------------------
# How long a worker holds a unit before it is reassigned, and how often it must say it is
# still alive. Browser tabs are backgrounded and throttled aggressively, so both are
# generous by design.
CAIRN_LEASE_SECONDS=900
CAIRN_HEARTBEAT_SECONDS=30

# Rounds of a bisection dispute a worker may leave unanswered before judgment defaults
# against it. Silence is penalised far more lightly than a proven false state transition.
CAIRN_DISPUTE_ROUND_TIMEOUT_SECONDS=120
